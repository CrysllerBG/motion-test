{
  "name": "motion-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Code-driven motion graphics: compositions are JSON, the editor plays, tweaks and exports them.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "validate": "node tools/validate.mjs compositions/*.json",
    "render": "node tools/render-frames.mjs",
    "export": "node tools/export.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
