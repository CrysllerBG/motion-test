{
  "name": "Dungeon Roller: title card",
  "notes": "Made from the prompt: a 10-second 2D title card for Dungeon Roller. Torch-lit stone wall, embers rising from two torches, a D20 face that traces itself in gold and flares with light, a parchment banner unrolling with the title stamped onto it, a tagline drifting in word by word, 'Coming soon', then fade to black.",
  "duration": 10,
  "fps": 30,
  "width": 1920,
  "height": 1080,
  "seed": 21,
  "background": "#000000",
  "fonts": ["Uncial Antiqua", "IM Fell English:400i", "IM Fell English SC"],
  "layers": [
    {
      "id": "wall",
      "type": "group",
      "label": "Wall",
      "animate": [{ "prop": "opacity", "from": 0, "to": 1, "start": 0, "duration": 1.2, "ease": "inOutQuad" }],
      "children": [
        {
          "id": "stone",
          "type": "background",
          "label": "Stone",
          "props": {
            "fill": {
              "type": "radial",
              "x": 50,
              "y": 42,
              "rx": 75,
              "ry": 85,
              "stops": [["#2b2019", 0], ["#140e0a", 0.6], ["#060403", 1]]
            }
          }
        },
        {
          "id": "pits",
          "type": "noise",
          "label": "Stone texture",
          "props": { "opacity": 0.45, "blend": "normal", "kind": "stone", "color": "#000000" }
        }
      ]
    },
    {
      "id": "torchL",
      "type": "group",
      "label": "Left torch",
      "animate": [{ "prop": "opacity", "from": 0, "to": 1, "start": 0.2, "duration": 0.9, "ease": "outCubic" }],
      "children": [
        {
          "id": "lightL",
          "type": "glow",
          "label": "Torchlight",
          "props": { "x": 12, "y": 50, "width": 42, "height": 48, "color": "#ff8a3d73", "softness": 5 },
          "animate": [
            { "prop": "opacity", "wave": { "amp": 0.08, "period": 0.23 } },
            { "prop": "opacity", "wave": { "amp": 0.06, "period": 0.41, "phase": 0.3 } },
            { "prop": "opacity", "wave": { "amp": 0.04, "period": 0.13, "phase": 0.6 } }
          ]
        },
        {
          "id": "bracketL",
          "type": "shape",
          "label": "Sconce bracket",
          "props": {
            "shape": "rect",
            "x": 12,
            "y": 66.5,
            "width": 0.7,
            "height": 6,
            "fill": "#17110c",
            "stroke": "#4a3526",
            "strokeWidth": 0.08
          }
        },
        {
          "id": "cupL",
          "type": "shape",
          "label": "Sconce cup",
          "props": {
            "shape": "rect",
            "x": 12,
            "y": 61.6,
            "width": 2.6,
            "height": 1.1,
            "radius": 0.2,
            "fill": "#231a13",
            "stroke": "#6b4a30",
            "strokeWidth": 0.08
          }
        },
        {
          "id": "flameL",
          "type": "glow",
          "label": "Flame",
          "props": {
            "blend": "lighter",
            "x": 12,
            "y": 57.2,
            "width": 3.2,
            "height": 7.5,
            "color": "#ffc35e",
            "softness": 0.7
          },
          "animate": [
            { "prop": "scale", "wave": { "amp": 0.08, "period": 0.19 } },
            { "prop": "dx", "wave": { "amp": 0.15, "period": 0.37 } }
          ]
        },
        {
          "id": "embersL",
          "type": "particles",
          "label": "Embers",
          "props": { "preset": "embers", "count": 45, "x": 12, "y": 60, "width": 2 }
        }
      ]
    },
    {
      "id": "torchR",
      "type": "group",
      "label": "Right torch",
      "animate": [{ "prop": "opacity", "from": 0, "to": 1, "start": 0.6, "duration": 0.9, "ease": "outCubic" }],
      "children": [
        {
          "id": "lightR",
          "type": "glow",
          "label": "Torchlight",
          "props": { "x": 88, "y": 50, "width": 42, "height": 48, "color": "#ff8a3d73", "softness": 5 },
          "animate": [
            { "prop": "opacity", "wave": { "amp": 0.08, "period": 0.27, "phase": 0.5 } },
            { "prop": "opacity", "wave": { "amp": 0.06, "period": 0.43 } },
            { "prop": "opacity", "wave": { "amp": 0.04, "period": 0.11, "phase": 0.2 } }
          ]
        },
        {
          "id": "bracketR",
          "type": "shape",
          "label": "Sconce bracket",
          "props": {
            "shape": "rect",
            "x": 88,
            "y": 66.5,
            "width": 0.7,
            "height": 6,
            "fill": "#17110c",
            "stroke": "#4a3526",
            "strokeWidth": 0.08
          }
        },
        {
          "id": "cupR",
          "type": "shape",
          "label": "Sconce cup",
          "props": {
            "shape": "rect",
            "x": 88,
            "y": 61.6,
            "width": 2.6,
            "height": 1.1,
            "radius": 0.2,
            "fill": "#231a13",
            "stroke": "#6b4a30",
            "strokeWidth": 0.08
          }
        },
        {
          "id": "flameR",
          "type": "glow",
          "label": "Flame",
          "props": {
            "blend": "lighter",
            "x": 88,
            "y": 57.2,
            "width": 3.2,
            "height": 7.5,
            "color": "#ffc35e",
            "softness": 0.7
          },
          "animate": [
            { "prop": "scale", "wave": { "amp": 0.08, "period": 0.21, "phase": 0.4 } },
            { "prop": "dx", "wave": { "amp": 0.15, "period": 0.33 } }
          ]
        },
        {
          "id": "embersR",
          "type": "particles",
          "label": "Embers",
          "props": { "preset": "embers", "count": 45, "x": 88, "y": 60, "width": 2, "seed": 2 }
        }
      ]
    },
    {
      "id": "die",
      "type": "group",
      "label": "D20",
      "props": { "x": 50, "y": 34 },
      "animate": [
        { "prop": "dy", "wave": { "amp": 0.35, "period": 3.2 } },
        { "prop": "dy", "from": 0, "to": -4, "start": 3.8, "duration": 0.8, "ease": "inOutCubic" },
        { "prop": "scale", "from": 1, "to": 0.78, "start": 3.8, "duration": 0.8, "ease": "inOutCubic" }
      ],
      "children": [
        {
          "id": "dieGlow",
          "type": "glow",
          "label": "Glow",
          "props": { "x": 50, "y": 34, "width": 30, "height": 30, "color": "#ffb54d59", "softness": 2 },
          "animate": [
            { "prop": "opacity", "from": 0, "to": 1, "start": 2.6, "duration": 0.5, "ease": "outCubic" },
            { "prop": "opacity", "wave": { "amp": 0.12, "period": 1.6 } }
          ]
        },
        {
          "id": "face",
          "type": "shape",
          "label": "Hexagon",
          "props": {
            "shape": "polygon",
            "x": 50,
            "y": 34,
            "width": 17,
            "sides": 6,
            "fill": "#5a0c1000",
            "stroke": "#e8c477",
            "strokeWidth": 0.22
          },
          "animate": [
            { "prop": "draw", "from": 0, "to": 1, "start": 1.2, "duration": 1.4, "ease": "inOutQuad" },
            { "prop": "fill", "to": "#5a0c10", "start": 2.6, "duration": 0.4 }
          ]
        },
        {
          "id": "facet",
          "type": "shape",
          "label": "Triangle",
          "props": {
            "shape": "polygon",
            "x": 50,
            "y": 34.9,
            "width": 13.6,
            "sides": 3,
            "fill": "#00000000",
            "stroke": "#e8c47799",
            "strokeWidth": 0.12
          },
          "animate": [{ "prop": "draw", "from": 0, "to": 1, "start": 1.7, "duration": 1.1, "ease": "inOutQuad" }]
        },
        {
          "id": "twenty",
          "type": "text",
          "label": "20",
          "text": "20",
          "props": {
            "x": 50,
            "y": 36,
            "size": 4.8,
            "font": "IM Fell English",
            "italic": true,
            "color": "#ffd98a",
            "shadowColor": "#ffb54d",
            "shadowBlur": 1.4
          },
          "animate": [
            { "prop": "opacity", "from": 0, "to": 1, "start": 2.7, "duration": 0.25, "ease": "outCubic" },
            { "prop": "scale", "from": 1.8, "to": 1, "start": 2.7, "duration": 0.55, "ease": "outBack" }
          ]
        }
      ]
    },
    {
      "id": "flash",
      "type": "glow",
      "label": "Flash",
      "props": { "x": 50, "y": 34, "width": 80, "height": 56, "color": "#ffd696", "softness": 3 },
      "animate": [
        { "prop": "opacity", "from": 0, "to": 0.85, "start": 2.7, "duration": 0.08, "ease": "linear" },
        { "prop": "opacity", "to": 0, "start": 2.78, "duration": 0.9, "ease": "outCubic" }
      ]
    },
    {
      "id": "banner",
      "type": "shape",
      "label": "Banner",
      "props": {
        "shape": "rect",
        "x": 50,
        "y": 66,
        "width": 0,
        "height": 10,
        "radius": 0.5,
        "fill": "#d9c194",
        "stroke": "#6b4423",
        "strokeWidth": 0.22
      },
      "animate": [{ "prop": "width", "from": 0, "to": 64, "start": 4, "duration": 0.75, "ease": "outCubic" }]
    },
    {
      "id": "title",
      "type": "text",
      "label": "Title",
      "text": "Dungeon Roller",
      "props": { "y": 66, "size": 5.4, "font": "Uncial Antiqua", "color": "#2a170c", "letterSpacing": 0.03 },
      "animate": [
        { "prop": "opacity", "from": 0, "to": 1, "start": 4.6, "duration": 0.2, "ease": "outCubic" },
        { "prop": "scale", "from": 1.5, "to": 1, "start": 4.6, "duration": 0.35, "ease": "outCubic" },
        { "prop": "blur", "from": 0.4, "to": 0, "start": 4.6, "duration": 0.3, "ease": "outCubic" }
      ]
    },
    {
      "id": "tagline",
      "type": "text",
      "label": "Tagline",
      "text": "Fortune favours the bold",
      "split": "words",
      "stagger": 0.14,
      "props": {
        "y": 80,
        "size": 2.7,
        "font": "IM Fell English",
        "italic": true,
        "color": "#ecd7a6",
        "shadowColor": "#e0873a8c",
        "shadowBlur": 1.2
      },
      "animate": [
        { "prop": "opacity", "from": 0, "to": 1, "start": 5.6, "duration": 0.6, "ease": "outCubic" },
        { "prop": "dy", "from": 1, "to": 0, "start": 5.6, "duration": 0.7, "ease": "outCubic" }
      ]
    },
    {
      "id": "coming",
      "type": "text",
      "label": "Coming soon",
      "text": "COMING SOON",
      "split": "letters",
      "stagger": 0.03,
      "staggerFrom": "center",
      "props": { "y": 88, "size": 1.6, "font": "IM Fell English SC", "color": "#bba47b", "letterSpacing": 0.42 },
      "animate": [{ "prop": "opacity", "from": 0, "to": 1, "start": 6.8, "duration": 0.5, "ease": "outCubic" }]
    },
    {
      "id": "grain",
      "type": "noise",
      "label": "Film grain",
      "props": { "opacity": 0.06 }
    },
    {
      "id": "vignette",
      "type": "vignette",
      "label": "Vignette",
      "props": { "strength": 0.75 }
    },
    {
      "id": "fadeOut",
      "type": "shape",
      "label": "Fade to black",
      "props": { "x": 50, "y": 50, "width": 100, "height": 56.25, "fill": "#000000" },
      "animate": [{ "prop": "opacity", "from": 0, "to": 1, "start": 9.1, "duration": 0.9, "ease": "inOutQuad" }]
    }
  ]
}
